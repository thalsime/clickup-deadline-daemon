# Copie este arquivo para .env e preencha os valores reais
# cp .env.example .env
#
# AVISO: o .env contem segredos. Nunca versionar. Permissoes: www-data:www-data 640.

# ---------------------------------------------------------------------------
# Autenticacao
# ---------------------------------------------------------------------------

# Token de API do ClickUp da conta de servico dedicada.
# Obter em: https://app.clickup.com/settings/apps
# IMPORTANTE: use a conta de servico (nao a conta pessoal) para que o anti-loop
# funcione corretamente -- o daemon ignora acoes onde o ator e o dono deste token.
CLICKUP_API_TOKEN=pk_SEU_TOKEN_DE_SERVICO_AQUI

# Secret HMAC para validar assinatura dos webhooks (recomendado).
# ATENCAO: o ClickUp gera o proprio secret e ignora o valor passado na criacao.
# Copie o campo "secret" da resposta JSON de 'register_webhook.py register' para ca.
# Ao recriar o webhook, um novo secret e gerado -- atualizar este arquivo.
CLICKUP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Calculo de due_date
# ---------------------------------------------------------------------------

# Status que disparam o calculo de due_date e as regras de atribuicao.
# Separados por virgula, case-insensitive.
# IMPORTANTE: o nome deve bater exatamente com o status configurado no Space do ClickUp.
# Verificar em Settings -> Statuses. Exemplo no Space "Espaco da equipe": "em progresso".
# Nao usar "em andamento" sem confirmar o nome real no Space.
TRIGGER_STATUSES=em progresso,in progress

# Nome canonico do status-alvo para o PUT da regra 2 (promover tarefa pendente).
# Deve bater exatamente com o nome no Space (case-sensitive na API do ClickUp).
TARGET_STATUS=em progresso

# Status considerados "pendente" -- condicao para a regra 2 (separados por virgula).
PENDING_STATUSES=pendente

# Milissegundos por dia util (base 4h/dia = 14400000 ms).
# Alterar somente se a equipe mudar a base de horas/dia no ClickUp.
# Ver tabela de referencia em README.md secao 9.
# MS_PER_DAY=14400000

# ---------------------------------------------------------------------------
# Auditoria
# ---------------------------------------------------------------------------

# Backend de auditoria: "sqlite" (unico suportado atualmente).
# AUDIT_BACKEND=sqlite

# Caminho do arquivo SQLite de auditoria.
# AVISO: contem PII (IDs e emails de usuarios). Nunca versionar. Nao expor publicamente.
# Para consultar: sqlite3 /opt/clickup-deadline-daemon/audit.db
#   SELECT received_at, event_type, actor_name, field, before_value, after_value
#   FROM audit_log ORDER BY received_at DESC LIMIT 20;
# AUDIT_PATH=/opt/clickup-deadline-daemon/audit.db
