[Unit]
Description=ClickUp Deadline Daemon
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/clickup-deadline-daemon
EnvironmentFile=/opt/clickup-deadline-daemon/.env
ExecStart=/opt/clickup-deadline-daemon/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8765 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=clickup-deadline-daemon

[Install]
WantedBy=multi-user.target
