# /etc/nginx/sites-available/clickup-deadline-daemon
#
# Reverse proxy para o daemon FastAPI.
# Substitua SEU_DOMINIO pelo dominio ou IP do VPS.
# Para HTTPS (recomendado): use certbot --nginx -d SEU_DOMINIO

server {
    listen 80;
    server_name SEU_DOMINIO;

    # Redirecionar para HTTPS (descomentar apos configurar SSL)
    # return 301 https://$host$request_uri;

    location /webhook {
        proxy_pass         http://127.0.0.1:8765/webhook;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Signature $http_x_signature;
        proxy_read_timeout 10s;
    }

    location /health {
        proxy_pass http://127.0.0.1:8765/health;
    }
}
